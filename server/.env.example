# ============================================================================
# SakiStarsFC API configuration
# Copy to .env for local development:   copy .env.example .env   (Windows)
#                                        cp .env.example .env     (Mac/Linux)
# In production (Render) set these in the service's Environment settings.
# NEVER commit .env. Values here are examples only.
# ============================================================================

NODE_ENV=development
PORT=4000

# ---- Database (required) ----------------------------------------------------
# MongoDB Atlas: Database > Connect > Drivers. Replace ALL of <user>, <password>
# and <cluster> with your real values (no < > characters may remain).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sakistarsfc?retryWrites=true&w=majority

# ---- Website / CORS -----------------------------------------------------------
# Public website address, used in email links (verify email, reset password).
APP_URL=http://localhost:5173
# Comma-separated list of website origins allowed to call the API with cookies.
# Production example: https://sakistarsfc.com,https://www.sakistarsfc.com
CORS_ORIGINS=http://localhost:5173
# Number of proxies in front of the API, so rate limits see each visitor's real IP.
#   Local: 0
#   Render, website calling the API through the Vercel /api rewrite (default setup): 2
#   Render, website calling https://api.<your-domain> directly: 1
# Check it in Dashboard > System: "Your IP as the server sees it" must be your own IP.
TRUST_PROXY=0

# ---- Sign-in security ---------------------------------------------------------
# Required in production: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# (If empty in development, a temporary one is used and everyone is signed out on restart.)
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Cookies: Secure is forced on in production. Keep SameSite=lax (website and API on the same site).
COOKIE_SAMESITE=lax
# COOKIE_SECURE=false
# COOKIE_DOMAIN=

# ---- Email (Resend) ------------------------------------------------------------
# development: leave RESEND_API_KEY empty to print emails in this terminal instead.
# production:  RESEND_API_KEY and EMAIL_FROM are required. EMAIL_FROM must use a domain
#              you verified in Resend (SPF/DKIM/DMARC), e.g. "Saki Stars <no-reply@sakistarsfc.com>".
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Where website contact-form messages are forwarded (falls back to the club contact email in Settings).
CONTACT_INBOX_EMAIL=
# EMAIL_TRANSPORT=resend | console | disabled   (normally chosen automatically)

# ---- Media (Cloudinary) ---------------------------------------------------------
# Dashboard > Settings > API Keys. Leave all three empty to disable uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=saki-stars
MAX_IMAGE_MB=8
MAX_VIDEO_MB=100
MAX_VIDEO_SECONDS=600
MAX_DOCUMENT_MB=10

# ---- Limits & logging ------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# debug | info | warn | error | silent
LOG_LEVEL=debug

# ---- First admin (Club Director) -------------------------------------------------
# On start-up, if the database has NO active Director yet, the server creates one from
# these values (the password is bcrypt-hashed; the plain text is never stored).
# Once a Director exists these values are IGNORED, so a password you later change in
# Account > Security is never overwritten by a restart. After your first sign-in, delete
# DIRECTOR_PASSWORD from here / from Render.
# If an ordinary account already uses DIRECTOR_EMAIL (e.g. made on the Register page),
# it is promoted and its password is REPLACED with DIRECTOR_PASSWORD.
# Password rules: 10+ characters, letters AND numbers, must not contain the part of the
# email before "@" or the first name.
# Also used by: npm run director:create  (and  npm run director:create -- --recover)
DIRECTOR_EMAIL=
DIRECTOR_NAME=
DIRECTOR_PASSWORD=

# ---- Only for integration tests (npm test) -----------------------------------------
# A throwaway database. Tests create and drop their own databases on it.
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017
