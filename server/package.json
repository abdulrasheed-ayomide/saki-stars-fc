{
  "name": "sakistarsfc-server",
  "version": "0.1.0",
  "private": true,
  "description": "SakiStarsFC REST API",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "director:create": "node --env-file-if-exists=.env scripts/create-director.js",
    "db:indexes": "node --env-file-if-exists=.env scripts/sync-indexes.js",
    "backup:export": "node --env-file-if-exists=.env scripts/backup-export.js",
    "backup:restore": "node --env-file-if-exists=.env scripts/backup-restore.js",
    "seed:dev": "node --env-file-if-exists=.env scripts/seed-dev.js",
    "lint": "eslint ."
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bson": "^7.3.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "multer": "^2.4.0",
    "resend": "^6.28.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "supertest": "^7.3.0",
    "vitest": "^5.0.1"
  }
}
