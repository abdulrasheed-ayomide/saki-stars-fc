# Copy to .env.local for local development. Every VITE_ value is PUBLIC: it is bundled
# into the browser code, so never put secrets here. Club name, logo, contact details,
# social links and the homepage text come from the database (Dashboard > Settings).

# Where the browser sends API requests. Keep "/api/v1": in development the Vite proxy
# forwards it to the server, and on Vercel the rewrite in vercel.json does the same.
# That keeps the refresh cookie first-party (same site), so sign-in works on every browser.
VITE_API_BASE_URL=/api/v1

# Development only: where the Vite proxy forwards /api requests.
VITE_DEV_API_TARGET=http://localhost:4000

# Shown only for the split second before settings load, or if the API is unreachable.
VITE_CLUB_NAME=Saki Stars Sports Club
VITE_CLUB_SHORT_NAME=Saki Stars
